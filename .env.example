# Copy to .env locally (never commit). Cursor MCP reads from ~/.cursor/mcp.json env block.
CLAWPUMP_API_KEY=cpk_your_key_here
CLAWPUMP_DEFAULT_AGENT=89ca5e76-d59f-4276-8399-eecdf8bb3a04

# Operator (local / DigitalOcean)
SPECGUARD_OPERATOR=digitalocean
SPECGUARD_BASELINE_EQUITY=5.4
SPECGUARD_QUOTE_QTY=0.01
SPECGUARD_QUOTE_MARGIN_USDC=1.5
SPECGUARD_QUOTE_SPREAD_BPS=50
SPECGUARD_QUOTE_INTERVAL_MS=300000

# Push status.json to GitHub for Pages (PAT — no Actions billing required)
SPECGUARD_GIT_PUSH=1
GITHUB_TOKEN=ghp_your_pat_with_repo_scope

# SpecGuard v2 — Supabase (project ref oaosnhecdaptmyhrubfx, dashboard Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# SpecGuard v2 — Jupiter demo agent (Slice 3+, mainnet)
AGENT_KEYPAIR_PATH=agent/.keys/v2-agent.json
AGENT_RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_HELIUS_KEY
NEXT_PUBLIC_SOLANA_RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_HELIUS_KEY
NEXT_PUBLIC_SITE_URL=https://registry.specguard.xyz
NEXT_PUBLIC_PHOENIX_URL=https://specguard.xyz
NEXT_PUBLIC_SPECGUARD_AGENT_WALLET=
AGENT_POLICY_MEMO_SIG=
# AGENT_POLICY_JSON= optional; default agent/config/default-policy.json

# Jupiter (Slice 5+; optional — without key uses lite-api.jup.ag)
JUPITER_API_KEY=

# Agent quote cycle (Slice 6; defaults per docs/v2-decisions.md J3)
AGENT_QUOTE_SIZE_SOL=0.05
AGENT_SPREAD_BPS=50
AGENT_CYCLE_MS=300000
AGENT_SOL_FEE_RESERVE=0.05
# AGENT_PEAK_EQUITY_USDC=
# AGENT_LAST_HEARTBEAT_SEC=

# Helius (Slice 4+)
HELIUS_API_KEY=your_helius_api_key
HELIUS_WEBHOOK_ID=
HELIUS_WEBHOOK_AUTH_HEADER=Bearer_generate_a_long_random_secret
WEBHOOK_PUBLIC_URL=https://your-vercel-preview.vercel.app

# Vercel cron (Slice 9+)
CRON_SECRET=generate_a_long_random_secret

# PnL baseline at registration (Slice 10+; optional, default 0)
# PNL_BASELINE_USDC=
# PNL_BASELINE_SOL=

# $GUARD registration gate (Slice 13; 2M tokens @ 6 decimals)
GUARD_MIN_BALANCE_RAW=2000000000000
NEXT_PUBLIC_GUARD_MINT=BjbyvvuGbQwNZiYyk3aw1J9mAEUYkW1n5W5h6XAxxo5e
