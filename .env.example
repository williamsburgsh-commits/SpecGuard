# Copy to .env locally (never commit). Cursor MCP reads from ~/.cursor/mcp.json env block.
CLAWPUMP_API_KEY=cpk_your_key_here
CLAWPUMP_DEFAULT_AGENT=89ca5e76-d59f-4276-8399-eecdf8bb3a04

# Operator (local / DigitalOcean)
SPECGUARD_OPERATOR=digitalocean
SPECGUARD_BASELINE_EQUITY=5.4
SPECGUARD_QUOTE_SPREAD_BPS=50
SPECGUARD_QUOTE_INTERVAL_MS=300000

# Push status.json to GitHub for Pages (PAT — no Actions billing required)
SPECGUARD_GIT_PUSH=1
GITHUB_TOKEN=ghp_your_pat_with_repo_scope
