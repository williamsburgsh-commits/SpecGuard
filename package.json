{
  "name": "specguard-monorepo",
  "private": true,
  "engines": {
    "node": ">=22.0.0"
  },
  "workspaces": [
    "packages/*",
    "agent",
    "web",
    "site"
  ],
  "scripts": {
    "test:core": "npm test -w @specguardxyz/core",
    "test:sdk": "npm test -w @specguardxyz/sdk",
    "test:policy-v2": "node --env-file=.env --import tsx scripts/policy-v2-smoke.ts",
    "mcp:build": "npm run build -w @specguardxyz/mcp",
    "mcp:start": "npm run start -w @specguardxyz/mcp",
    "test:mcp": "npm run build -w @specguardxyz/mcp && tsx scripts/mcp-smoke.ts",
    "build:packages": "npm run build -w @specguardxyz/core && npm run build -w @specguardxyz/sdk && npm run build -w @specguardxyz/mcp",
    "publish:npm": "npm run build:packages && npm publish -w @specguardxyz/core --access public && npm publish -w @specguardxyz/mcp --access public",
    "test:supabase-rls": "node --env-file=.env scripts/supabase-rls-smoke.mjs",
    "test:supabase-schema": "node --env-file=.env scripts/supabase-schema-smoke.mjs",
    "agent:generate-wallet": "npm run generate-wallet -w @specguardxyz/agent",
    "agent:publish-policy": "npm run publish-policy -w @specguardxyz/agent",
    "agent:balance": "npm run balance -w @specguardxyz/agent",
    "agent:trigger-demo": "npm run trigger-demo -w @specguardxyz/agent",
    "agent:quote-cycle": "npm run quote-cycle -w @specguardxyz/agent --",
    "agent:flatten-drill": "npm run flatten-drill -w @specguardxyz/agent --",
    "agent:publish-heartbeat": "npm run publish-heartbeat -w @specguardxyz/agent",
    "test:ingest-heartbeat": "tsx scripts/ingest-heartbeat-smoke.ts",
    "test:heartbeat-sweep": "tsx scripts/heartbeat-sweep-smoke.ts",
    "test:agent": "npm test -w @specguardxyz/agent",
    "agent:export-phantom-import": "npm run export-phantom-import -w @specguardxyz/agent",
    "agent:self-transfer": "npm run self-transfer -w @specguardxyz/agent",
    "web:dev": "npm run dev -w @specguardxyz/web",
    "web:build": "npm run build -w @specguardxyz/web",
    "web:test": "npm test -w @specguardxyz/web",
    "helius:register-webhook": "tsx scripts/register-helius-webhook.ts",
    "test:ingest-smoke": "tsx scripts/ingest-smoke.ts",
    "webhook:replay-transfer": "tsx scripts/replay-onchain-transfer-webhook.ts",
    "webhook:replay-flatten": "tsx scripts/replay-flatten-webhook.ts",
    "verify:agent-status": "tsx scripts/verify-agent-status.ts",
    "test:ingest-flatten": "tsx scripts/ingest-flatten-smoke.ts",
    "test:pnl-refresh": "tsx scripts/pnl-refresh-smoke.ts",
    "test:guard-balance": "tsx scripts/guard-balance-smoke.ts",
    "test:helius-webhook-addresses": "tsx scripts/helius-webhook-addresses-smoke.ts",
    "test:cron-webhook-sync": "tsx scripts/cron-webhook-sync-smoke.ts",
    "test:cron-pnl-refresh": "tsx scripts/cron-pnl-refresh-smoke.ts",
    "test:cron-http": "tsx scripts/cron-http-smoke.ts",
    "test:production-urls": "tsx scripts/verify-production-urls-smoke.ts",
    "test:production-flatten": "tsx scripts/verify-production-flatten-drill.ts",
    "sync:flatten-registry": "tsx scripts/sync-flatten-registry-from-log.ts"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.30.1",
    "@supabase/supabase-js": "^2.49.1",
    "tsx": "^4.19.3"
  }
}
