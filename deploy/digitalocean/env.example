# Copy to /opt/specguard/.env on the droplet (chmod 600). Never commit.

# Required — ClawPump API
CLAWPUMP_API_KEY=cpk_your_key_here
CLAWPUMP_DEFAULT_AGENT=89ca5e76-d59f-4276-8399-eecdf8bb3a04

# Operator identity + quoting (Phase 11)
SPECGUARD_OPERATOR=digitalocean
SPECGUARD_BASELINE_EQUITY=5.4
SPECGUARD_QUOTE_SPREAD_BPS=50
SPECGUARD_QUOTE_INTERVAL_MS=300000

# Push status.json to GitHub for Pages (does NOT require Actions billing)
SPECGUARD_GIT_PUSH=1
GITHUB_TOKEN=ghp_your_pat_with_repo_scope
SPECGUARD_GIT_BRANCH=main
SPECGUARD_GIT_URL=https://github.com/williamsburgsh-commits/SpecGuard.git
